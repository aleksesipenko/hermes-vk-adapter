# VK community bot token. Secret. Keep the real value only on the VPS.
VK_GROUP_TOKEN="replace_me"

# Positive numeric VK community id, without a minus sign.
VK_GROUP_ID="replace_me"

# Keep aligned with the VK Long Poll API version enabled in the VK UI.
VK_API_VERSION="5.199"

# Strict personal allowlist. Comma-separated numeric VK user ids.
VK_ALLOWED_USERS="replace_me"
VK_ALLOW_ALL_USERS="false"

# Default VK peer_id for cron/proactive delivery.
VK_HOME_PEER_ID="replace_me"

# Group chat behavior.
VK_REQUIRE_MENTION="true"

# Show a persistent VK command keyboard on normal text responses.
VK_COMMAND_KEYBOARD="true"

# Runtime tuning.
VK_POLL_WAIT_SECONDS="25"
VK_MAX_MESSAGE_LENGTH="8500"
VK_DEBUG_UPDATES="false"
